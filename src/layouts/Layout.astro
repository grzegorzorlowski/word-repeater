---
import "../styles/global.css";
import Toolbar from "@/components/Toolbar.astro";
import { isPublicPath } from "@/lib/constants/routes";

interface Props {
  title?: string;
}

const { title = "10x Astro Starter" } = Astro.props;

// Get user from locals (set by middleware)
const user = Astro.locals.user;

// Show toolbar only for authenticated users on protected routes
const showToolbar = user && !isPublicPath(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    {showToolbar && <Toolbar userEmail={user.email || "User"} />}
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
