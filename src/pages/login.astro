---
import AuthLayout from "@/layouts/AuthLayout.astro";
import { LoginForm } from "@/components/auth/LoginForm";

// Get redirect parameter from URL
const redirectTo = Astro.url.searchParams.get("redirect") || "/dashboard";
---

<AuthLayout title="Login - WordRepeater">
  <div class="space-y-6" data-testid="login-page">
    <div class="text-center">
      <h1 class="text-2xl font-bold" data-testid="login-page-title">Welcome Back</h1>
      <p class="text-muted-foreground mt-2">Sign in to your account</p>
    </div>

    <LoginForm client:load redirectTo={redirectTo} />

    <div class="text-center text-sm">
      <p class="text-muted-foreground">
        Don't have an account?{" "}
        <a href="/register" class="text-primary hover:underline font-medium" data-testid="register-link"> Sign up </a>
      </p>
    </div>
  </div>
</AuthLayout>
