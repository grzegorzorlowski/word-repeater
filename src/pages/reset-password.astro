---
import AuthLayout from "@/layouts/AuthLayout.astro";
import { ResetPasswordForm } from "@/components/auth/ResetPasswordForm";
import { isFeatureEnabled } from "@/features";

// Check if resetPassword feature is enabled
if (!isFeatureEnabled("resetPassword")) {
  return Astro.redirect("/login");
}

// Extract token from URL
const token = Astro.url.searchParams.get("token");

// If no token, redirect to forgot password page
if (!token) {
  return Astro.redirect("/forgot-password");
}
---

<AuthLayout title="Set New Password - WordRepeater">
  <div class="space-y-6">
    <div class="text-center">
      <h1 class="text-2xl font-bold">Set New Password</h1>
      <p class="text-muted-foreground mt-2">Choose a strong password for your account</p>
    </div>

    <ResetPasswordForm client:load token={token} />
  </div>
</AuthLayout>
