---
/**
 * Toolbar Component
 * Displays user information and logout button for authenticated users on protected routes
 */
import { LogoutButton } from "./auth/LogoutButton";

interface Props {
  userEmail: string;
}

const { userEmail } = Astro.props;

// Get current path to highlight active navigation
const currentPath = Astro.url.pathname;
---

<header class="w-full bg-card border-b border-border sticky top-0 z-50">
  <div class="container mx-auto px-4 py-3">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <a
          href="/dashboard"
          class="text-lg font-semibold hover:text-primary transition-colors"
          aria-label="WordRepeater home"
        >
          WordRepeater
        </a>
        <nav class="hidden md:flex items-center gap-4" aria-label="Main navigation">
          <a
            href="/dashboard"
            class={`text-sm transition-colors ${currentPath === "/dashboard" ? "text-foreground font-medium" : "text-muted-foreground hover:text-foreground"}`}
            aria-current={currentPath === "/dashboard" ? "page" : undefined}
          >
            Dashboard
          </a>
          <a
            href="/generate"
            class={`text-sm transition-colors ${currentPath === "/generate" ? "text-foreground font-medium" : "text-muted-foreground hover:text-foreground"}`}
            aria-current={currentPath === "/generate" ? "page" : undefined}
          >
            Generate
          </a>
          <a
            href="/flashcards"
            class={`text-sm transition-colors ${currentPath.startsWith("/flashcards") ? "text-foreground font-medium" : "text-muted-foreground hover:text-foreground"}`}
            aria-current={currentPath.startsWith("/flashcards") ? "page" : undefined}
          >
            My Flashcards
          </a>
          <a
            href="/learn"
            class={`text-sm transition-colors ${currentPath === "/learn" ? "text-foreground font-medium" : "text-muted-foreground hover:text-foreground"}`}
            aria-current={currentPath === "/learn" ? "page" : undefined}
          >
            Start learning
          </a>
        </nav>
      </div>

      <div class="flex items-center gap-2 md:gap-4">
        <div class="flex items-center gap-2">
          <span class="text-sm text-muted-foreground hidden sm:inline">Signed in as:</span>
          <span
            class="text-sm font-medium truncate max-w-[150px] sm:max-w-[200px]"
            aria-label={`Logged in as ${userEmail}`}
            title={userEmail}
          >
            {userEmail}
          </span>
        </div>

        <LogoutButton client:load variant="ghost" className="h-9 px-3" />
      </div>
    </div>
  </div>
</header>
