---
/**
 * DashboardHeader Component
 * Displays the view title with proper accessibility attributes and logout button.
 */
interface Props {
  title?: string;
}

const { title = "Dashboard" } = Astro.props;
---

<header class="mb-8 flex items-center justify-between" role="banner">
  <h1 class="text-4xl font-bold text-foreground" aria-label={title}>
    {title}
  </h1>
</header>
