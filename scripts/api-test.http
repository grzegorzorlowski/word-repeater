### Word Repeater API - Test Requests
### Use with REST Client extension in VS Code or similar tools

# Variables
@baseUrl = http://localhost:3000
@contentType = application/json

# Set these after creating/getting flashcards
@flashcardId = d1fc501a-970a-4c72-80a3-8c995470a855

###############################################################################
# 1. Generate AI Flashcards
###############################################################################

### Generate AI flashcards from text
POST {{baseUrl}}/api/flashcards/generate
Content-Type: {{contentType}}

{
  "text": "Photosynthesis is the process by which plants use sunlight, water, and carbon dioxide to create oxygen and energy in the form of sugar. Chlorophyll, the green pigment in plants, captures light energy. This process occurs in the chloroplasts of plant cells. The light-dependent reactions happen in the thylakoid membrane, while the light-independent reactions (Calvin cycle) occur in the stroma. Photosynthesis is essential for life on Earth as it produces oxygen and serves as the primary source of energy for most living organisms. Plants convert approximately 3-6% of available solar energy into chemical energy through photosynthesis.",
  "limit": 3
}

### Generate with minimum text length (500 chars)
POST {{baseUrl}}/api/flashcards/generate
Content-Type: {{contentType}}

{
  "text": "The water cycle, also known as the hydrological cycle, describes the continuous movement of water on, above, and below the surface of the Earth. Water evaporates from the surface of oceans, lakes, and rivers, as well as from the soil and plants through transpiration. This water vapor rises into the atmosphere where it cools and condenses to form clouds. When the water droplets in clouds become too heavy, they fall as precipitation in the form of rain, snow, sleet, or hail. Some of this water is absorbed by plants, some runs off into rivers and streams, and some seeps into the ground to become groundwater. This groundwater eventually makes its way back to the oceans, completing the cycle.",
  "limit": 5
}

### Test validation - text too short (should fail)
POST {{baseUrl}}/api/flashcards/generate
Content-Type: {{contentType}}

{
  "text": "Too short",
  "limit": 5
}

###############################################################################
# 2. List User Flashcards
###############################################################################

### Get all flashcards (default pagination)
GET {{baseUrl}}/api/flashcards

### Get flashcards with pagination
GET {{baseUrl}}/api/flashcards?page=1&limit=10

### Filter by source (AI-generated only)
GET {{baseUrl}}/api/flashcards?source=ai_generated

### Filter by source (manual only)
GET {{baseUrl}}/api/flashcards?source=manual

### Filter by status (active only)
GET {{baseUrl}}/api/flashcards?status=active

### Filter by status (pending only)
GET {{baseUrl}}/api/flashcards?status=pending

### Combined filters
GET {{baseUrl}}/api/flashcards?source=ai_generated&status=pending&page=1&limit=5

### Combined filters 2
GET {{baseUrl}}/api/flashcards?source=ai_generated&status=active&page=1&limit=5

###############################################################################
# 3. Create Manual Flashcard
###############################################################################

### Create a simple manual flashcard
POST {{baseUrl}}/api/flashcards
Content-Type: {{contentType}}

{
  "question": "What is the capital of France?",
  "answer": "Paris"
}

### Create manual flashcard with metadata
POST {{baseUrl}}/api/flashcards
Content-Type: {{contentType}}

{
  "question": "What is the chemical formula for water?",
  "answer": "H2O",
  "metadata": {
    "tags": ["chemistry", "basics"],
    "difficulty": "easy"
  }
}

### Create flashcard with longer content
POST {{baseUrl}}/api/flashcards
Content-Type: {{contentType}}

{
  "question": "Explain the difference between mitosis and meiosis",
  "answer": "Mitosis is cell division that produces two identical daughter cells with the same number of chromosomes as the parent cell. Meiosis is a special type of cell division that produces four non-identical sex cells (gametes) with half the number of chromosomes."
}

### Test validation - missing question (should fail)
POST {{baseUrl}}/api/flashcards
Content-Type: {{contentType}}

{
  "answer": "Paris"
}

### Test validation - empty question (should fail)
POST {{baseUrl}}/api/flashcards
Content-Type: {{contentType}}

{
  "question": "",
  "answer": "Some answer"
}

###############################################################################
# 4. Update Flashcard
###############################################################################

### Update flashcard content
# Replace @flashcardId with actual ID from previous requests
PUT {{baseUrl}}/api/flashcards/{{flashcardId}}
Content-Type: {{contentType}}

{
  "question": "What is the capital of France? (Updated)",
  "answer": "Paris is the capital and largest city of France."
}

### Update only question
PUT {{baseUrl}}/api/flashcards/{{flashcardId}}
Content-Type: {{contentType}}

{
  "question": "What is the capital city of France?"
}

### Update only answer
PUT {{baseUrl}}/api/flashcards/{{flashcardId}}
Content-Type: {{contentType}}

{
  "answer": "Paris, located in northern France, is the capital and most populous city."
}

### Test validation - both fields empty (should fail)
PUT {{baseUrl}}/api/flashcards/{{flashcardId}}
Content-Type: {{contentType}}

{
  "question": "",
  "answer": ""
}

### Test validation - invalid UUID (should fail)
PUT {{baseUrl}}/api/flashcards/invalid-uuid
Content-Type: {{contentType}}

{
  "question": "Updated question"
}

###############################################################################
# 5. Accept/Reject AI Flashcard
###############################################################################

### Accept an AI-generated pending flashcard
# Replace @flashcardId with actual AI-generated pending flashcard ID
POST {{baseUrl}}/api/flashcards/{{flashcardId}}/decision
Content-Type: {{contentType}}

{
  "decision": "accept"
}

### Reject an AI-generated pending flashcard
POST {{baseUrl}}/api/flashcards/{{flashcardId}}/decision
Content-Type: {{contentType}}

{
  "decision": "reject"
}

### Test validation - invalid decision (should fail)
POST {{baseUrl}}/api/flashcards/{{flashcardId}}/decision
Content-Type: {{contentType}}

{
  "decision": "maybe"
}

### Test validation - missing decision (should fail)
POST {{baseUrl}}/api/flashcards/{{flashcardId}}/decision
Content-Type: {{contentType}}

{}

### Test validation - invalid UUID (should fail)
POST {{baseUrl}}/api/flashcards/invalid-uuid/decision
Content-Type: {{contentType}}

{
  "decision": "accept"
}

###############################################################################
# 6. Delete Flashcard
###############################################################################

### Delete (soft delete) a flashcard
# Replace @flashcardId with actual ID
DELETE {{baseUrl}}/api/flashcards/{{flashcardId}}

### Test validation - invalid UUID (should fail)
DELETE {{baseUrl}}/api/flashcards/invalid-uuid

### Test - delete non-existent flashcard (should return 404)
DELETE {{baseUrl}}/api/flashcards/00000000-0000-0000-0000-000000000000

###############################################################################
# Common Test Scenarios
###############################################################################

### Workflow 1: Create AI flashcards and accept one
# Step 1: Generate AI flashcards
POST {{baseUrl}}/api/flashcards/generate
Content-Type: {{contentType}}

{
  "text": "Machine learning is a subset of artificial intelligence that enables systems to learn and improve from experience without being explicitly programmed. It focuses on developing computer programs that can access data and use it to learn for themselves. The process of learning begins with observations or data, such as examples, direct experience, or instruction, in order to look for patterns in data and make better decisions in the future. The primary aim is to allow computers to learn automatically without human intervention or assistance.",
  "limit": 3
}

# Step 2: List pending AI flashcards to get IDs
# GET {{baseUrl}}/api/flashcards?source=ai_generated&status=pending

# Step 3: Accept a specific flashcard (use ID from step 2)
# POST {{baseUrl}}/api/flashcards/{id}/decision
# { "decision": "accept" }

### Workflow 2: Create manual flashcard and update it
# Step 1: Create manual flashcard
POST {{baseUrl}}/api/flashcards
Content-Type: {{contentType}}

{
  "question": "What is JavaScript?",
  "answer": "A programming language"
}

# Step 2: Update it with more detailed answer (use ID from response)
# PUT {{baseUrl}}/api/flashcards/{id}
# {
#   "answer": "JavaScript is a high-level, interpreted programming language that is one of the core technologies of the World Wide Web, alongside HTML and CSS."
# }

### Workflow 3: List all active flashcards for review
GET {{baseUrl}}/api/flashcards?status=active&limit=20

###############################################################################
# Error Testing
###############################################################################

### Test malformed JSON (should fail)
POST {{baseUrl}}/api/flashcards
Content-Type: {{contentType}}

{
  "question": "Test",
  "answer": "Test"
  // Missing comma or malformed JSON
}

### Test invalid Content-Type (should fail)
POST {{baseUrl}}/api/flashcards/generate
Content-Type: text/plain

This is plain text, not JSON

### Test empty request body where required (should fail)
POST {{baseUrl}}/api/flashcards/generate
Content-Type: {{contentType}}

{}

###############################################################################
# Notes:
# - All endpoints use the DEFAULT_USER until authentication is implemented
# - Flashcard IDs are UUIDs - replace @flashcardId with actual values
# - Status codes:
#   - 200: Success
#   - 400: Bad Request (validation failed)
#   - 404: Not Found
#   - 500: Internal Server Error
# - Pagination defaults: page=1, limit=20
# - Source values: "manual", "ai_generated"
# - Status values: "pending", "active", "archived"
###############################################################################

